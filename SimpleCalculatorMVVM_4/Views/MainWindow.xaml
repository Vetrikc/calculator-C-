<Window x:Class="SimpleCalculatorMVVM_4.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SimpleCalculatorMVVM — Decorator Pattern"
        Height="640" Width="300"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}"
        FontFamily="{DynamicResource CustomFont}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Очистить" Command="{Binding ClearCommand}"/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Отменить" Command="{Binding UndoCommand}"/>
                <MenuItem Header="Повторить" Command="{Binding RedoCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Стили для слабовидящих">
                    <MenuItem Header="Высокий контраст" Click="SetHighContrastTheme"/>
                </MenuItem>
                <MenuItem Header="Светлый / Темный">
                    <MenuItem Header="Светлая тема" Click="SetLightTheme"/>
                    <MenuItem Header="Темная тема" Click="SetDarkTheme"/>
                </MenuItem>
                <MenuItem Header="По гендерному признаку">
                    <MenuItem Header="Мужской стиль" Click="SetMaleStyle"/>
                    <MenuItem Header="Женский стиль" Click="SetFemaleStyle"/>
                </MenuItem>
                <MenuItem Header="По возрастному признаку">
                    <MenuItem Header="Для детей" Click="SetChildrenStyle"/>
                    <MenuItem Header="Для молодежи" Click="SetYouthStyle"/>
                    <MenuItem Header="Для среднего возраста" Click="SetAdultStyle"/>
                    <MenuItem Header="Для пожилых" Click="SetElderlyStyle"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Звук" x:Name="ToggleSoundMenuItem" Click="ToggleSound"/>
            </MenuItem>
        </Menu>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- Дисплей -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource DisplayBackground}" 
                    CornerRadius="10" 
                    Padding="14,8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExprDisplay, Mode=OneWay}"
                               FontSize="13" 
                               Foreground="#555"
                               HorizontalAlignment="Right" 
                               Height="20"/>
                    <TextBlock Text="{Binding Display, Mode=OneWay}"
                               FontSize="38" 
                               FontWeight="Light" 
                               Foreground="{DynamicResource TextColor}"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Сетка кнопок -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Строка 0 -->
                <Button Content="C"  Grid.Row="0" Grid.Column="0" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding ClearCommand}"/>

                <Button Content="±"  Grid.Row="0" Grid.Column="1" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding NegateCommand}"/>

                <Button Content="%"  Grid.Row="0" Grid.Column="2" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding PercentCommand}"/>

                <Button Content="÷"  Grid.Row="0" Grid.Column="3" 
                        Background="{DynamicResource ButtonSpecialColor}" 
                        Foreground="White"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding OperatorCommand}" CommandParameter="/"/>

                <!-- Строка 1 -->
                <Button Content="7"  Grid.Row="1" Grid.Column="0" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="7"/>

                <Button Content="8"  Grid.Row="1" Grid.Column="1" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="8"/>

                <Button Content="9"  Grid.Row="1" Grid.Column="2" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="9"/>

                <Button Content="×"  Grid.Row="1" Grid.Column="3" 
                        Background="{DynamicResource ButtonSpecialColor}" 
                        Foreground="White"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding OperatorCommand}" CommandParameter="*"/>

                <!-- Строка 2 -->
                <Button Content="4"  Grid.Row="2" Grid.Column="0" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="4"/>

                <Button Content="5"  Grid.Row="2" Grid.Column="1" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="5"/>

                <Button Content="6"  Grid.Row="2" Grid.Column="2" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="6"/>

                <Button Content="−"  Grid.Row="2" Grid.Column="3" 
                        Background="{DynamicResource ButtonSpecialColor}" 
                        Foreground="White"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding OperatorCommand}" CommandParameter="-"/>

                <!-- Строка 3 -->
                <Button Content="1"  Grid.Row="3" Grid.Column="0" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="1"/>

                <Button Content="2"  Grid.Row="3" Grid.Column="1" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="2"/>

                <Button Content="3"  Grid.Row="3" Grid.Column="2" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="3"/>

                <Button Content="+"  Grid.Row="3" Grid.Column="3" 
                        Background="{DynamicResource ButtonSpecialColor}" 
                        Foreground="White"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding OperatorCommand}" CommandParameter="+"/>

                <!-- Строка 4 -->
                <Button Content="0"  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DigitCommand}" CommandParameter="0"/>

                <Button Content="."  Grid.Row="4" Grid.Column="2" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DotCommand}"/>

                <Button Content="="  Grid.Row="4" Grid.Column="3" 
                        Background="{DynamicResource ButtonEqualColor}" 
                        Foreground="White"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding EqualsCommand}"/>

                <!-- Строка 5 -->
                <Button Content="↩"  Grid.Row="5" Grid.Column="0" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding UndoCommand}"/>

                <Button Content="↪"  Grid.Row="5" Grid.Column="1" 
                        Background="{DynamicResource ButtonColor}" 
                        Foreground="{DynamicResource TextColor}"
                        FontSize="17" Margin="5" BorderThickness="0" Cursor="Hand"
                        Command="{Binding RedoCommand}"/>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Row="2" Margin="0,6,0,4">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Height="1" Fill="#333" VerticalAlignment="Center" Width="60"/>
                    <TextBlock Text=" 🔎 Decorator Log " Foreground="#444" FontSize="11" VerticalAlignment="Center"/>
                    <Rectangle Height="1" Fill="#333" VerticalAlignment="Center" Width="60"/>
                </StackPanel>
            </Border>

            <!-- Журнал -->
            <Border Grid.Row="3" Background="#111" CornerRadius="8" Padding="6">
                <ListBox ItemsSource="{Binding OperationLog}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas"
                         FontSize="10"
                         Foreground="#5FD"
                         SelectionMode="Single"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>