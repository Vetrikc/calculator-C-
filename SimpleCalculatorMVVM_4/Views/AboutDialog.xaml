<Window x:Class="SimpleCalculatorMVVM_4.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О калькуляторе" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Simple Calculator MVVM" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Text="Версия: 1.0" FontSize="14" Margin="0,5"/>
        <TextBlock Text="Паттерны: MVVM, Decorator, Command" FontSize="14" Margin="0,5"/>
        <TextBlock Text="Разработчик: Учебный проект" FontSize="14" Margin="0,5"/>

        <Separator Margin="0,15,0,15"/>

        <TextBlock Text="Используемые ресурсы:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Text="• Кастомный курсор (.cur)"/>
        <TextBlock Text="• Звуковые эффекты (.wav)"/>
        <TextBlock Text="• Кастомный шрифт (.ttf)"/>

        <Button Content="OK" Width="100" Height="30" Margin="0,20,0,0"
                HorizontalAlignment="Center" Click="Ok_Click"/>
    </StackPanel>
</Window>