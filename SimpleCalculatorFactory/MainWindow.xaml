<Window x:Class="SimpleCalculatorFactory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleCalculatorFactory" Height="460" Width="300"
        ResizeMode="NoResize"
        Background="#0F0F0F"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="10" Padding="14,8">
            <StackPanel VerticalAlignment="Center">
                <!-- строка выражения -->
                <TextBlock x:Name="ExprDisplay"
                           Text=""
                           FontSize="13"
                           Foreground="#555"
                           HorizontalAlignment="Right"
                           Height="20"/>
                <!-- основной результат -->
                <TextBlock x:Name="Display"
                           Text="0"
                           FontSize="38"
                           FontWeight="Light"
                           Foreground="#F0F0F0"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Сетка кнопок -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <!-- Базовый стиль -->
                <Style x:Key="Btn" TargetType="Button">
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="50">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Строка 0 -->
            <Button Content="C"  Grid.Row="0" Grid.Column="0" Style="{StaticResource Btn}" Background="#333" Foreground="#00E5FF"   Click="Btn_Click" Tag="C"/>
            <Button Content="±"  Grid.Row="0" Grid.Column="1" Style="{StaticResource Btn}" Background="#333" Foreground="#00E5FF"   Click="Btn_Click" Tag="±"/>
            <Button Content="%"  Grid.Row="0" Grid.Column="2" Style="{StaticResource Btn}" Background="#333" Foreground="#00E5FF"   Click="Btn_Click" Tag="%"/>
            <Button Content="÷"  Grid.Row="0" Grid.Column="3" Style="{StaticResource Btn}" Background="#FF6B35" Foreground="White"  Click="Btn_Click" Tag="/"/>

            <!-- Строка 1 -->
            <Button Content="7"  Grid.Row="1" Grid.Column="0" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="7"/>
            <Button Content="8"  Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="8"/>
            <Button Content="9"  Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="9"/>
            <Button Content="×"  Grid.Row="1" Grid.Column="3" Style="{StaticResource Btn}" Background="#FF6B35" Foreground="White"  Click="Btn_Click" Tag="*"/>

            <!-- Строка 2 -->
            <Button Content="4"  Grid.Row="2" Grid.Column="0" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="4"/>
            <Button Content="5"  Grid.Row="2" Grid.Column="1" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="5"/>
            <Button Content="6"  Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="6"/>
            <Button Content="−"  Grid.Row="2" Grid.Column="3" Style="{StaticResource Btn}" Background="#FF6B35" Foreground="White"  Click="Btn_Click" Tag="-"/>

            <!-- Строка 3 -->
            <Button Content="1"  Grid.Row="3" Grid.Column="0" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="1"/>
            <Button Content="2"  Grid.Row="3" Grid.Column="1" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="2"/>
            <Button Content="3"  Grid.Row="3" Grid.Column="2" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="3"/>
            <Button Content="+"  Grid.Row="3" Grid.Column="3" Style="{StaticResource Btn}" Background="#FF6B35" Foreground="White"  Click="Btn_Click" Tag="+"/>

            <!-- Строка 4 -->
            <Button Content="0"  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"
                    Click="Btn_Click" Tag="0"/>
            <Button Content="."  Grid.Row="4" Grid.Column="2" Style="{StaticResource Btn}" Background="#222" Foreground="#F0F0F0"   Click="Btn_Click" Tag="."/>
            <Button Content="="  Grid.Row="4" Grid.Column="3" Style="{StaticResource Btn}" Background="#00C853" Foreground="White"  Click="Btn_Click" Tag="="/>
        </Grid>
    </Grid>
</Window>
