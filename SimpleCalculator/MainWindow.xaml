<Window x:Class="SimpleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="420" Width="280"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="12,8">
            <TextBlock x:Name="Display"
                       Text="0"
                       FontSize="36"
                       FontFamily="Consolas"
                       Foreground="#CDD6F4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Стиль кнопок через ресурсы -->
            <Grid.Resources>
                <Style x:Key="CalcBtn" TargetType="Button">
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Строка 0: C, ±, %, ÷ -->
            <Button Content="C"   Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcBtn}" Background="#F38BA8" Foreground="#1E1E2E" Click="OnClear"/>
            <Button Content="±"   Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcBtn}" Background="#45475A" Foreground="#CDD6F4" Click="OnNegate"/>
            <Button Content="%"   Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcBtn}" Background="#45475A" Foreground="#CDD6F4" Click="OnPercent"/>
            <Button Content="÷"   Grid.Row="0" Grid.Column="3" Style="{StaticResource CalcBtn}" Background="#FAB387" Foreground="#1E1E2E" Click="OnOperator" Tag="/"/>

            <!-- Строка 1: 7, 8, 9, × -->
            <Button Content="7"   Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="8"   Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="9"   Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="×"   Grid.Row="1" Grid.Column="3" Style="{StaticResource CalcBtn}" Background="#FAB387" Foreground="#1E1E2E" Click="OnOperator" Tag="*"/>

            <!-- Строка 2: 4, 5, 6, − -->
            <Button Content="4"   Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="5"   Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="6"   Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="−"   Grid.Row="2" Grid.Column="3" Style="{StaticResource CalcBtn}" Background="#FAB387" Foreground="#1E1E2E" Click="OnOperator" Tag="-"/>

            <!-- Строка 3: 1, 2, 3, + -->
            <Button Content="1"   Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="2"   Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="3"   Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="+"   Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcBtn}" Background="#FAB387" Foreground="#1E1E2E" Click="OnOperator" Tag="+"/>

            <!-- Строка 4: 0 (широкий), ., = -->
            <Button Content="0"   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDigit"/>
            <Button Content="."   Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcBtn}" Background="#313244" Foreground="#CDD6F4" Click="OnDot"/>
            <Button Content="="   Grid.Row="4" Grid.Column="3" Style="{StaticResource CalcBtn}" Background="#A6E3A1" Foreground="#1E1E2E" Click="OnEquals"/>
        </Grid>
    </Grid>
</Window>
